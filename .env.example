# Model Radar warehouse environment configuration
# Copy to .env and fill in real values. NEVER commit .env.

# MySQL 5.7 (design also compatible with 8.0)
DB_HOST=<your-mysql-host>
DB_PORT=3306
DB_USER=<your-mysql-user>
DB_PASSWORD=<your-mysql-password>
DB_NAME=<your-mysql-database>

# Admin API token (required; generate a random one)
ADMIN_API_TOKEN=<generate-a-random-token>

# Artificial Analysis Data API (optional; system degrades without it)
AA_API_KEY=
AA_BASE_URL=https://artificialanalysis.ai/api/v2
